{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SQD collector configuration",
  "type": "object",
  "properties": {
    "update_every": {
      "title": "Update every",
      "description": "Data collection interval in seconds.",
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "workers": {
      "title": "SQD Workers",
      "description": "List of SQD workers to monitor",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "title": "Worker name",
            "description": "A unique name for the worker.",
            "type": "string",
            "default": "worker"
          },
          "prometheus_url": {
            "title": "Prometheus URL",
            "description": "URL of the Prometheus metrics endpoint.",
            "type": "string",
            "format": "uri",
            "default": "http://localhost:9090"
          },
          "graphql_url": {
            "title": "GraphQL URL",
            "description": "URL of the GraphQL API endpoint.",
            "type": "string",
            "format": "uri",
            "default": "https://subsquid.squids.live/subsquid-network-mainnet/graphql"
          }
        },
        "required": ["prometheus_url", "graphql_url"]
      }
    }
  },
  "required": ["workers"]
}
