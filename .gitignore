# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work

# Dependency directories (remove these if you're including dependencies in repo)
vendor/

# Build output
build/
bin/
dist/

# IDE specific files
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Project-specific build output
# Only ignore plugin files, not directories
build/*.plugin
dist/*.plugin

# Netdata configuration files (create on local install)
*.conf.local

# Log files
*.log

# Temporary files
tmp/
temp/
